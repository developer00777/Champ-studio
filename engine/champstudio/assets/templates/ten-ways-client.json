{
  "cst": "1.0",
  "id": "ten-ways-client",
  "name": "10 Ways [Client] Can Use Data",
  "category": "sales-enablement",
  "description": "Personalised listicle for a named prospect: ten concrete use cases in two pages, framed by an intro and a booking CTA.",
  "tags": [
    "10 ways",
    "listicle",
    "personalized",
    "use cases",
    "proposal",
    "account based"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "company",
      "title",
      "ways_1",
      "ways_2",
      "cta"
    ],
    "properties": {
      "company": {
        "type": "string",
        "maxLength": 32,
        "x-kind": "text",
        "description": "Client company name (or {company} for batch)"
      },
      "title": {
        "type": "string",
        "maxLength": 56,
        "x-kind": "text",
        "description": "Title, e.g. 10 ways {company} can grow with B2B data"
      },
      "subtitle": {
        "type": "string",
        "maxLength": 70,
        "x-kind": "text",
        "description": "Line under the title"
      },
      "bg": {
        "x-kind": "media",
        "description": "Visual of the client's industry"
      },
      "ways_1": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Use cases 1–5"
      },
      "ways_2": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Use cases 6–10"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 200,
        "x-kind": "voiceover",
        "description": "Voiceover introducing the list"
      },
      "vo_ways_1": {
        "type": "string",
        "maxLength": 500,
        "x-kind": "voiceover",
        "description": "Voiceover for use cases 1–5"
      },
      "vo_ways_2": {
        "type": "string",
        "maxLength": 500,
        "x-kind": "voiceover",
        "description": "Voiceover for use cases 6–10"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "company": "{company}",
    "title": "10 ways {company} can grow with B2B data",
    "subtitle": "Ideas tailored to your market, built on verified data.",
    "ways_1": [
      "Map your total addressable market",
      "Find look-alikes of your best clients",
      "Reach full buying groups",
      "Time outreach with intent signals",
      "Enrich every inbound lead"
    ],
    "ways_2": [
      "Clean and de-duplicate your CRM",
      "Launch account-based ad audiences",
      "Spot champions changing jobs",
      "Enter new regions with confidence",
      "Measure pipeline by segment"
    ],
    "cta_headline": "Let's pick your top three",
    "cta": "Book a strategy call",
    "music": "calm-tech"
  },
  "scenes": [
    {
      "id": "intro",
      "role": "hook",
      "duration": {
        "mode": "voiceover",
        "min": 3.5,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_intro"
      },
      "layers": [
        {
          "type": "media",
          "src": {
            "$slot": "bg"
          },
          "motion": "kenburns-in"
        },
        {
          "type": "shape",
          "name": "Scrim",
          "shape": {
            "kind": "rect",
            "gradient": [
              "#00000033",
              "#000000CC"
            ]
          }
        },
        {
          "type": "text",
          "text": "Prepared for {{company}}",
          "style": {
            "$brand": "styles.lower_third",
            "size": 28,
            "uppercase": true
          },
          "box": {
            "*": [
              0.08,
              0.27,
              0.6,
              0.065
            ],
            "vertical": [
              0.08,
              0.3,
              0.84,
              0.056
            ]
          },
          "anim_in": {
            "type": "slide-right",
            "sec": 0.4
          }
        },
        {
          "type": "text",
          "text": "{{title}}",
          "style": {
            "$brand": "styles.title",
            "size": 92,
            "align": "left",
            "valign": "top"
