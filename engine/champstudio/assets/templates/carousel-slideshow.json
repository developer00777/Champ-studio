{
  "cst": "1.0",
  "id": "carousel-slideshow",
  "name": "Carousel Slideshow",
  "category": "social-ads",
  "description": "Four full-bleed visuals with punchy captions and a branded end card. Turns a static carousel into a video ad.",
  "tags": [
    "ad",
    "carousel",
    "slideshow",
    "photos",
    "instagram"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "title",
      "image_1",
      "caption_1",
      "image_2",
      "caption_2",
      "cta"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Opening title over the first slide"
      },
      "image_1": {
        "x-kind": "media",
        "description": "Slide 1 visual"
      },
      "caption_1": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Caption for slide 1"
      },
      "image_2": {
        "x-kind": "media",
        "description": "Slide 2 visual"
      },
      "caption_2": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Caption for slide 2"
      },
      "image_3": {
        "x-kind": "media",
        "description": "Slide 3 visual"
      },
      "caption_3": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Caption for slide 3"
      },
      "image_4": {
        "x-kind": "media",
        "description": "Slide 4 visual"
      },
      "caption_4": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Caption for slide 4"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "title": "One platform. Every growth signal.",
    "caption_1": "Find accounts showing intent",
    "caption_2": "Reach the whole buying group",
    "caption_3": "Launch campaigns in minutes",
    "caption_4": "Measure pipeline, not clicks",
    "cta_headline": "See it on your own data",
    "cta": "Start free trial",
    "music": "energetic"
  },
