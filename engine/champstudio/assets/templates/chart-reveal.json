{
  "cst": "1.0",
  "id": "chart-reveal",
  "name": "Chart Reveal",
  "category": "data-leadership",
  "description": "Four horizontal bars grow in, shortest to longest, with the winner in brand colour, then the insight and a CTA. Bar lengths are fixed; order your data ascending.",
  "tags": [
    "chart",
    "bar chart",
    "data",
    "comparison",
    "insight"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "title",
      "bar_1_label",
      "bar_1_value",
      "bar_4_label",
      "bar_4_value",
      "insight",
      "cta"
    ],
    "properties": {
      "kicker": {
        "type": "string",
        "maxLength": 28,
        "x-kind": "text",
        "description": "Small label above the title"
      },
      "title": {
        "type": "string",
        "maxLength": 52,
        "x-kind": "text",
        "description": "Chart question, e.g. Reply rate by data source"
      },
      "bar_1_label": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Bar 1 label (bars grow shortest to longest; bar 4 is highlighted)"
      },
      "bar_1_value": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "Bar 1 value as displayed, e.g. 6.4%"
      },
      "bar_2_label": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Bar 2 label (bars grow shortest to longest; bar 4 is highlighted)"
      },
      "bar_2_value": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "Bar 2 value as displayed, e.g. 6.4%"
      },
      "bar_3_label": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Bar 3 label (bars grow shortest to longest; bar 4 is highlighted)"
      },
      "bar_3_value": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "Bar 3 value as displayed, e.g. 6.4%"
      },
      "bar_4_label": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Bar 4 label (bars grow shortest to longest; bar 4 is highlighted)"
      },
      "bar_4_value": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "Bar 4 value as displayed, e.g. 6.4%"
      },
      "source": {
        "type": "string",
        "maxLength": 60,
        "x-kind": "text",
        "description": "Source note under the chart"
      },
      "insight": {
        "type": "string",
        "maxLength": 64,
        "x-kind": "text",
        "description": "The takeaway in one line"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover posing the question"
      },
      "vo_chart": {
        "type": "string",
        "maxLength": 280,
        "x-kind": "voiceover",
        "description": "Voiceover walking through the chart"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover for the insight and CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "kicker": "Data drop",
    "title": "Cold email reply rate by data source",
    "bar_1_label": "Cold lists",
    "bar_1_value": "1.2%",
    "bar_2_label": "Firmographic",
    "bar_2_value": "2.8%",
    "bar_3_label": "Intent only",
