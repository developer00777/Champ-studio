{
  "cst": "1.0",
  "id": "job-of-the-week",
  "name": "Job of the Week",
  "category": "recruitment",
  "description": "Spotlight one open role: title with location, type and level chips, three responsibilities, the package line and an apply CTA.",
  "tags": [
    "job",
    "hiring",
    "role spotlight",
    "recruitment",
    "weekly"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "role",
      "duties",
      "cta"
    ],
    "properties": {
      "role": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Job title"
      },
      "location": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Location, e.g. Remote (UK)"
      },
      "job_type": {
        "type": "string",
        "maxLength": 16,
        "x-kind": "text",
        "description": "Type, e.g. Full-time"
      },
      "level": {
        "type": "string",
        "maxLength": 16,
        "x-kind": "text",
        "description": "Level, e.g. Senior"
      },
      "duties": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Three key responsibilities"
      },
      "package": {
        "type": "string",
        "maxLength": 56,
        "x-kind": "text",
        "description": "Salary or headline perk"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_role": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover introducing the role"
      },
      "vo_duties": {
        "type": "string",
        "maxLength": 260,
        "x-kind": "voiceover",
        "description": "Voiceover for the responsibilities"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover for the package and CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "role": "Senior Data Engineer",
    "location": "Remote (UK)",
    "job_type": "Full-time",
    "level": "Senior",
    "duties": [
      "Own pipelines for 120M+ B2B records",
      "Design our real-time enrichment layer",
      "Mentor a team of four engineers"
    ],
    "package": "£85–100k + equity + learning budget",
    "cta": "Apply this week",
    "music": "corporate-upbeat"
  },
  "scenes": [
