{
  "cst": "1.0",
  "id": "mg-cta-swipe-up",
  "name": "Swipe Up",
  "category": "motion-graphics",
  "description": "Bouncing chevrons above a short call to action — made for stories and reels.",
  "tags": [
    "graphic",
    "cta",
    "social",
    "vertical"
  ],
  "aspects": [
    "16:9",
    "9:16",
