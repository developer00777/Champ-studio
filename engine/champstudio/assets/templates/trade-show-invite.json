{
  "cst": "1.0",
  "id": "trade-show-invite",
  "name": "Trade Show Invite",
  "category": "events",
  "description": "Invite prospects to your booth: show name over a visual, booth number with dates, reasons to stop by, and a book-a-meeting CTA.",
  "tags": [
    "trade show",
    "booth",
    "conference",
    "invite",
    "meeting"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "show",
      "booth",
      "dates",
      "reasons",
      "cta"
    ],
    "properties": {
      "show": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Show name"
      },
      "bg": {
        "x-kind": "media",
        "description": "Expo hall or show atmosphere visual"
      },
      "booth": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "Booth number"
      },
      "dates": {
        "type": "string",
        "maxLength": 32,
        "x-kind": "text",
        "description": "Dates, e.g. 3–5 March"
      },
      "city": {
        "type": "string",
        "maxLength": 32,
        "x-kind": "text",
        "description": "City and venue"
      },
      "reasons": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Three reasons to visit the booth"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the invite"
      },
      "vo_booth": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover for where and when"
      },
      "vo_reasons": {
        "type": "string",
        "maxLength": 260,
        "x-kind": "voiceover",
        "description": "Voiceover for the reasons"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "show": "HLTH USA 2026",
    "booth": "#1427",
    "dates": "16–19 November",
    "city": "Las Vegas · Venetian Expo",
    "reasons": [
      "Live demo of our physician database",
      "Free data audit for your CRM",
      "Meet the research team"
    ],
    "cta_headline": "Lock in a time with our team",
    "cta": "Book a meeting",
    "music": "corporate-upbeat"
  },
  "scenes": [
    {
      "id": "intro",
      "role": "hook",
      "duration": {
        "mode": "voiceover",
        "min": 2.5,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_intro"
      },
      "layers": [
        {
          "type": "media",
          "src": {
            "$slot": "bg"
          },
          "motion": "kenburns-in"
        },
        {
          "type": "shape",
          "name": "Scrim",
          "shape": {
            "kind": "rect",
            "gradient": [
              "#00000033",
              "#000000CC"
            ]
          }
        },
        {
          "type": "text",
          "text": "Meet us at",
          "style": {
            "$brand": "styles.lower_third",
            "size": 28,
            "uppercase": true
          },
          "box": {
            "*": [
              0.08,
              0.27,
              0.6,
              0.065
            ],
            "vertical": [
              0.08,
              0.3,
              0.84,
              0.056
            ]
          },
          "anim_in": {
            "type": "slide-right",
            "sec": 0.4
          }
        },
        {
          "type": "text",
          "text": "{{show}}",
          "style": {
            "$brand": "styles.title",
            "size": 110,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.36,
              0.8,
              0.3
            ],
            "vertical": [
              0.08,
              0.36,
              0.84,
              0.24
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.5
          },
          "start": 0.15
        }
      ]
    },
    {
      "id": "booth",
      "role": "details",
      "duration": {
        "mode": "voiceover",
        "min": 3.5,
        "pad": 0.5
      },
      "vo": {
        "$slot": "vo_booth"
      },
      "transition": {
        "type": "slide-left",
