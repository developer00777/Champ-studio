{
  "cst": "1.0",
  "id": "personalized-prospect",
  "name": "Personalized Prospect Video",
  "category": "sales-enablement",
  "description": "One-to-one prospecting video, batch-ready: greets {first_name}, names what you noticed at {company}, how you help, proof and a booking CTA.",
  "tags": [
    "personalized",
    "prospecting",
    "outbound",
    "1:1 video",
    "batch",
    "sales"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "greeting",
      "observation",
      "helps",
      "cta"
    ],
    "properties": {
      "greeting": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Greeting, e.g. Hi {first_name},"
      },
      "intro_line": {
        "type": "string",
        "maxLength": 60,
        "x-kind": "text",
        "description": "Line under the greeting"
      },
      "observation": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "text",
        "description": "What you noticed about their company"
      },
      "helps": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Three ways you can help them"
      },
      "proof": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "Proof number, e.g. 3x"
      },
      "proof_label": {
        "type": "string",
        "maxLength": 56,
        "x-kind": "text",
        "description": "What the number means, ideally for a similar company"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "bg": {
        "x-kind": "media",
        "description": "Optional visual of the prospect's industry"
      },
      "vo_greeting": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover greeting the prospect by name"
      },
      "vo_observation": {
        "type": "string",
        "maxLength": 260,
        "x-kind": "voiceover",
        "description": "Voiceover for the observation"
      },
      "vo_helps": {
        "type": "string",
        "maxLength": 300,
        "x-kind": "voiceover",
        "description": "Voiceover for how you help"
      },
      "vo_proof": {
        "type": "string",
        "maxLength": 180,
        "x-kind": "voiceover",
        "description": "Voiceover for the proof"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "greeting": "Hi {first_name},",
    "intro_line": "I made this quick video for the {company} team.",
    "observation": "{company} is hiring 12 sales reps this quarter. That's a lot of territory to fill with good data.",
    "helps": [
      "Ready-built lists for every new territory",
      "Verified direct dials for faster ramp",
      "Intent alerts so reps call at the right time"
    ],
    "proof": "3x",
    "proof_label": "faster ramp for a similar team at Northwind",
    "cta_headline": "Worth 15 minutes, {first_name}?",
    "cta": "Pick a time",
    "music": "chill"
  },
  "scenes": [
    {
      "id": "greeting",
      "role": "hook",
      "duration": {
        "mode": "voiceover",
        "min": 3,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_greeting"
      },
      "layers": [
        {
          "type": "media",
          "src": {
            "$slot": "bg"
          },
          "motion": "kenburns-in"
        },
        {
          "type": "shape",
          "name": "Scrim",
          "shape": {
            "kind": "rect",
            "gradient": [
              "#000000AA",
              "#000000EE"
            ]
          }
        },
        {
          "type": "text",
          "text": "{{greeting}}",
          "style": {
            "$brand": "styles.title",
            "size": 130,
            "align": "left"
          },
          "box": {
            "*": [
              0.08,
              0.3,
              0.84,
              0.24
            ],
            "vertical": [
              0.08,
              0.34,
              0.84,
              0.16
            ]
          },
          "anim_in": {
