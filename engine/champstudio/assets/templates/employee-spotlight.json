{
  "cst": "1.0",
  "id": "employee-spotlight",
  "name": "Employee Spotlight",
  "category": "recruitment",
  "description": "Celebrate a team member: portrait with name and role, their quote in their words, three fun facts, and a join-us CTA.",
  "tags": [
    "employee spotlight",
    "culture",
    "team",
    "employer brand",
    "people"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "name",
      "role",
      "quote",
      "cta"
    ],
    "properties": {
      "portrait": {
        "x-kind": "media",
        "description": "Portrait photo or short clip of the employee"
      },
      "name": {
        "type": "string",
        "maxLength": 32,
        "x-kind": "text",
        "description": "Employee name"
      },
      "role": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Role and team"
      },
      "tenure": {
        "type": "string",
        "maxLength": 28,
        "x-kind": "text",
        "description": "Tenure or location, e.g. 4 years · Chennai"
      },
      "quote": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "text",
        "description": "What they love about the work"
      },
      "facts": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 40
        },
        "description": "Three fun facts or highlights"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover introducing them"
      },
      "vo_quote": {
        "type": "string",
        "maxLength": 300,
        "x-kind": "voiceover",
        "description": "Voiceover for the quote"
      },
      "vo_facts": {
        "type": "string",
        "maxLength": 240,
        "x-kind": "voiceover",
        "description": "Voiceover for the facts"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "name": "Kavya Iyer",
    "role": "Lead Research Analyst, Healthcare Data",
    "tenure": "5 years · Chennai",
    "quote": "Every record I verify helps a hospital reach the right people. That impact is real, and I see it every day.",
    "facts": [
      "Verified her 1 millionth record",
      "Runs our book club",
      "Trained 30+ new analysts"
    ],
    "cta": "Join our team",
    "music": "chill"
  },
