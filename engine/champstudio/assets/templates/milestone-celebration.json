{
  "cst": "1.0",
  "id": "milestone-celebration",
  "name": "Milestone Celebration",
  "category": "company-news",
  "description": "Celebrate a company milestone: a giant number with confetti, the story behind it over a visual, thank-yous, and a sign-off.",
  "tags": [
    "milestone",
    "anniversary",
    "celebration",
    "company news",
    "thank you"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "number",
      "unit",
      "signoff"
    ],
    "properties": {
      "number": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "The milestone number, e.g. 10 or 1,000"
      },
      "unit": {
        "type": "string",
        "maxLength": 28,
        "x-kind": "text",
        "description": "What it counts, e.g. years of growth"
      },
      "story": {
        "type": "string",
        "maxLength": 80,
        "x-kind": "text",
        "description": "One line on how you got here"
      },
      "photo": {
        "x-kind": "media",
        "description": "Team, office or archive visual"
      },
      "thanks": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 32
        },
        "description": "Three groups to thank, e.g. Our clients"
      },
      "signoff": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Sign-off line, e.g. Here's to the next ten"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_number": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the milestone"
      },
      "vo_story": {
        "type": "string",
        "maxLength": 260,
        "x-kind": "voiceover",
        "description": "Voiceover for the story"
      },
      "vo_thanks": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for the thank-yous"
      },
      "vo_signoff": {
        "type": "string",
        "maxLength": 120,
        "x-kind": "voiceover",
        "description": "Voiceover for the sign-off"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "number": "10",
    "unit": "years of building growth",
    "story": "From a two-person data desk to twelve ventures across four continents.",
    "thanks": [
      "Our clients",
      "Our 900+ people",
      "Our partners"
    ],
    "signoff": "Here's to the next ten",
    "cta": "Read our story",
    "music": "inspiring"
  },
