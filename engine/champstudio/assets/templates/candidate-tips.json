{
  "cst": "1.0",
  "id": "candidate-tips",
  "name": "Candidate Tips",
  "category": "recruitment",
  "description": "Three numbered career or interview tips, one per scene, bookended by a title and a CTA. Ideal for recruitment brands.",
  "tags": [
    "career tips",
    "interview",
    "candidates",
    "recruitment",
    "advice"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "title",
      "tip_1",
      "tip_2",
      "tip_3",
      "cta"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Title, e.g. 3 ways to ace a sales interview"
      },
      "tip_1": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Tip 1"
      },
      "tip_1_body": {
        "type": "string",
        "maxLength": 80,
        "x-kind": "text",
        "description": "Tip 1 one-line detail"
      },
      "vo_tip_1": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for tip 1"
      },
      "tip_2": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Tip 2"
      },
      "tip_2_body": {
        "type": "string",
        "maxLength": 80,
        "x-kind": "text",
        "description": "Tip 2 one-line detail"
      },
      "vo_tip_2": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for tip 2"
      },
      "tip_3": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Tip 3"
      },
      "tip_3_body": {
        "type": "string",
        "maxLength": 80,
        "x-kind": "text",
        "description": "Tip 3 one-line detail"
      },
      "vo_tip_3": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for tip 3"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the title"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "title": "3 ways to ace your next B2B sales interview",
    "tip_1": "Research the buyer, not just the company",
    "tip_1_body": "Know who they sell to and how they win deals.",
    "tip_2": "Bring numbers to every answer",
    "tip_2_body": "Quantify the pipeline, revenue or time you moved.",
    "tip_3": "Ask about their data",
    "tip_3_body": "Smart questions show you think like an owner.",
    "cta_headline": "Ready for your next role?",
    "cta": "Browse open jobs",
    "music": "chill"
  },
