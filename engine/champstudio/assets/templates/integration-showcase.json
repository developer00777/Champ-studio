{
  "cst": "1.0",
  "id": "integration-showcase",
  "name": "Integration Showcase",
  "category": "product-promo",
  "description": "Your product as the hub with up to six integrations around it, a benefit line and a CTA.",
  "tags": [
    "integrations",
    "ecosystem",
    "saas",
    "partners",
    "api"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "headline",
      "tool_1",
      "tool_2",
      "tool_3",
      "cta"
    ],
    "properties": {
      "headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Headline, e.g. Plugs into the stack you already use"
      },
      "tool_1": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Integration 1 name"
      },
      "tool_2": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Integration 2 name"
      },
      "tool_3": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Integration 3 name"
      },
      "tool_4": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Integration 4 name"
      },
      "tool_5": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Integration 5 name"
      },
      "tool_6": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Integration 6 name"
      },
      "benefit": {
        "type": "string",
        "maxLength": 60,
        "x-kind": "text",
        "description": "What the integrations unlock"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the headline"
      },
      "vo_hub": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover naming the integrations"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "headline": "Plugs into the stack you already use",
    "tool_1": "Salesforce",
    "tool_2": "HubSpot",
    "tool_3": "Outreach",
    "tool_4": "Slack",
    "tool_5": "Marketo",
