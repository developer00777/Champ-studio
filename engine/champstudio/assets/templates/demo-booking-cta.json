{
  "cst": "1.0",
  "id": "demo-booking-cta",
  "name": "Demo Booking CTA",
  "category": "sales-enablement",
  "description": "Short demo-booking push: pain question, what they'll see in the demo, and a calendar-card CTA.",
  "tags": [
    "demo",
    "booking",
    "meeting",
    "cta",
    "sales"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "hook",
      "agenda",
      "cta"
    ],
    "properties": {
      "hook": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Pain question"
      },
      "agenda_title": {
        "type": "string",
        "maxLength": 36,
        "x-kind": "text",
        "description": "Heading, e.g. In 20 minutes you'll see"
      },
      "agenda": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Three things the demo shows"
      },
      "length": {
        "type": "string",
        "maxLength": 16,
        "x-kind": "text",
        "description": "Demo length, e.g. 20 min"
      },
      "promise": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Low-friction line, e.g. No slides. Your data."
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_hook": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the hook"
      },
      "vo_agenda": {
        "type": "string",
        "maxLength": 280,
        "x-kind": "voiceover",
        "description": "Voiceover for the agenda"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "hook": "How many good accounts did you miss?",
    "agenda_title": "In 20 minutes you'll see",
    "agenda": [
      "Your total addressable market, sized",
      "Which accounts are in-market right now",
      "The contacts your reps are missing"
    ],
    "length": "20 min",
    "promise": "No slides. Just your market.",
    "cta": "Book your demo",
    "music": "corporate-upbeat"
  },
  "scenes": [
    {
      "id": "hook",
      "role": "hook",
      "duration": {
        "mode": "voiceover",
        "min": 2.5,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_hook"
      },
      "layers": [
        {
          "type": "color",
          "color": {
            "$brand": "colors.dark"
          }
        },
        {
          "type": "text",
          "text": "{{hook}}",
          "style": {
            "$brand": "styles.title",
            "size": 96,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.3,
              0.84,
              0.4
            ],
            "vertical": [
              0.08,
              0.32,
              0.84,
              0.3
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.45
          }
        }
      ]
    },
    {
      "id": "agenda",
      "role": "list",
      "duration": {
        "mode": "voiceover",
        "min": 5,
        "pad": 0.5
      },
      "vo": {
        "$slot": "vo_agenda"
      },
      "transition": {
        "type": "wipe-left",
        "sec": 0.4
      },
      "layers": [
        {
          "type": "color",
          "color": {
            "$brand": "colors.background"
          }
        },
        {
          "type": "text",
          "text": "{{agenda_title}}",
          "style": {
            "$brand": "styles.subtitle",
            "size": 32,
            "weight": 800,
            "uppercase": true,
            "color": {
              "$brand": "colors.primary"
            },
            "align": "left"
          },
          "box": {
            "*": [
              0.08,
              0.14,
              0.84,
              0.07
            ],
            "vertical": [
              0.08,
              0.2,
              0.84,
              0.04
            ]
          },
          "anim_in": {
            "type": "fade",
            "sec": 0.3
          }
        },
        {
          "type": "list",
          "name": "Numbers",
          "items": [
            "01",
            "02",
            "03"
          ],
          "stagger": 1.2,
          "style": {
            "$brand": "styles.subtitle",
            "color": {
              "$brand": "colors.primary"
            },
            "weight": 800,
            "align": "left",
            "size": 48
          },
          "box": {
            "*": [
              0.08,
              0.26,
              0.08,
              0.56
            ],
            "vertical": [
              0.08,
              0.27,
              0.14,
              0.44
            ]
          },
          "anim_in": {
            "type": "fade",
            "sec": 0.3
          },
          "start": 0.3
        },
        {
          "type": "list",
          "items": {
            "$slot": "agenda"
          },
          "stagger": 1.2,
          "style": {
            "$brand": "styles.subtitle",
            "color": {
              "$brand": "colors.text"
            },
            "weight": 600,
            "size": 48,
            "align": "left"
          },
          "box": {
            "*": [
              0.16,
              0.26,
              0.76,
              0.56
            ],
            "vertical": [
              0.22,
              0.27,
              0.7,
              0.44
            ]
          },
          "anim_in": {
            "type": "slide-left",
            "sec": 0.35
          },
          "start": 0.3
        }
      ]
    },
    {
      "id": "cta",
      "role": "cta",
      "duration": {
        "mode": "voiceover",
        "min": 3,
        "pad": 0.6
      },
      "vo": {
        "$slot": "vo_cta"
      },
      "transition": {
        "type": "crossfade",
        "sec": 0.4
      },
      "layers": [
        {
          "type": "shape",
          "shape": {
            "kind": "rect",
            "gradient": {
              "$brand": "gradients.hero"
            }
          }
        },
        {
          "type": "shape",
          "name": "Calendar",
          "shape": {
            "kind": "rect",
            "fill": "#FFFFFF",
            "radius": 0.08
          },
          "box": {
            "*": [
              0.36,
              0.1,
              0.28,
              0.42
            ],
            "vertical": [
              0.2,
              0.14,
              0.6,
              0.27
            ]
          },
          "anim_in": {
            "type": "pop",
            "sec": 0.45
          }
        },
        {
          "type": "shape",
          "name": "Calendar header",
          "shape": {
            "kind": "rect",
            "fill": {
              "$brand": "colors.dark"
            },
            "radius": 0.3
          },
          "box": {
            "*": [
              0.36,
              0.1,
              0.28,
              0.1
            ],
            "vertical": [
              0.2,
              0.14,
              0.6,
              0.06
            ]
          },
          "anim_in": {
            "type": "pop",
            "sec": 0.45
          }
        },
        {
          "type": "text",
          "text": "Your demo",
          "style": {
            "$brand": "styles.subtitle",
            "size": 26,
            "weight": 800,
            "uppercase": true,
            "align": "center"
          },
          "box": {
            "*": [
              0.36,
              0.1,
              0.28,
              0.1
            ],
            "vertical": [
              0.2,
              0.14,
              0.6,
              0.06
            ]
          },
          "anim_in": {
            "type": "fade",
            "sec": 0.3
          },
          "start": 0.3
        },
        {
          "type": "text",
          "text": "{{length}}",
          "style": {
            "$brand": "styles.title",
            "color": {
              "$brand": "colors.primary"
            },
            "shadow": false,
            "size": 110
          },
          "box": {
            "*": [
              0.37,
              0.22,
              0.26,
              0.26
            ],
            "vertical": [
              0.22,
              0.21,
              0.56,
              0.18
            ]
          },
          "anim_in": {
            "type": "pop",
            "sec": 0.4
          },
          "start": 0.35
        },
        {
          "type": "text",
          "text": "{{promise}}",
          "if": "promise",
          "style": {
            "$brand": "styles.title",
            "size": 60
          },
          "box": {
            "*": [
              0.1,
              0.56,
              0.8,
              0.12
            ],
            "vertical": [
              0.08,
              0.45,
              0.84,
              0.1
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.4
          },
          "start": 0.5
        },
        {
          "type": "text",
          "text": "{{cta}}",
          "style": {
            "$brand": "styles.button",
            "bg_color": "#FFFFFF",
            "color": {
              "$brand": "colors.primary"
            }
          },
          "box": {
            "*": [
              0.3,
              0.7,
              0.4,
              0.14
            ],
            "vertical": [
              0.12,
              0.58,
              0.76,
              0.1
            ]
          },
          "anim_in": {
            "type": "pop",
            "sec": 0.45
          },
          "start": 0.7
        }
      ]
    }
  ],
  "audio": {
    "music": {
      "$slot": "music"
    },
    "music_volume": 0.3,
    "duck_db": 9
  },
  "captions": {
    "enabled": true,
    "box": {
      "*": [
        0.1,
        0.84,
        0.8,
        0.11
      ],
      "vertical": [
        0.06,
        0.81,
        0.88,
        0.09
      ]
    }
  }
}
