{
  "cst": "1.0",
  "id": "event-recap",
  "name": "Event Recap",
  "category": "events",
  "description": "Three highlight moments, the event in numbers and a thank-you with what's next. For the morning after.",
  "tags": [
    "event recap",
    "highlights",
    "conference",
    "thank you",
    "social"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "event",
      "caption_1",
      "stat_1",
      "stat_1_label",
      "thanks",
      "cta"
    ],
    "properties": {
      "event": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Event name"
      },
      "photo_1": {
        "x-kind": "media",
        "description": "Event highlight photo or clip 1"
      },
      "caption_1": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Caption for highlight 1"
      },
      "photo_2": {
        "x-kind": "media",
        "description": "Event highlight photo or clip 2"
      },
      "caption_2": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Caption for highlight 2"
      },
      "photo_3": {
        "x-kind": "media",
        "description": "Event highlight photo or clip 3"
      },
      "caption_3": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Caption for highlight 3"
      },
      "stat_1": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "First number, e.g. 1,200"
      },
      "stat_1_label": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "First number label, e.g. attendees"
      },
      "stat_2": {
        "type": "string",
        "maxLength": 8,
        "x-kind": "text",
        "description": "Second number"
      },
      "stat_2_label": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Second number label"
      },
      "thanks": {
        "type": "string",
        "maxLength": 56,
        "x-kind": "text",
        "description": "Thank-you line"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action, e.g. Watch the sessions"
      },
      "vo_highlights": {
        "type": "string",
        "maxLength": 400,
        "x-kind": "voiceover",
        "description": "Voiceover across the highlights"
      },
      "vo_numbers": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover for the numbers"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the thank-you and CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "event": "Growth Summit 2026",
    "caption_1": "Two days. One mission.",
    "caption_2": "40 sessions on data-driven growth",
    "caption_3": "And a lot of great conversations",
    "stat_1": "1,200",
    "stat_1_label": "attendees",
    "stat_2": "40",
    "stat_2_label": "expert sessions",
    "thanks": "Thank you for making it our best year yet",
    "cta": "Watch the sessions",
    "music": "inspiring"
  },
  "scenes": [
    {
      "id": "moment1",
      "role": "highlight",
      "duration": {
        "mode": "voiceover",
        "min": 3.2,
        "pad": 0.2
      },
      "vo": {
        "$slot": "vo_highlights"
      },
      "layers": [
        {
          "type": "media",
          "src": {
            "$slot": "photo_1"
          },
          "motion": "kenburns-in"
        },
        {
          "type": "shape",
          "name": "Scrim",
          "shape": {
            "kind": "rect",
            "gradient": [
              "#00000000",
              "#000000CC"
            ]
          }
        },
        {
          "type": "text",
          "text": "{{event}} · Recap",
          "style": {
            "$brand": "styles.lower_third",
            "size": 28,
            "uppercase": true
          },
          "box": {
            "*": [
              0.07,
              0.66,
              0.6,
              0.065
            ],
            "vertical": [
              0.07,
              0.64,
              0.86,
              0.056
            ]
          },
          "anim_in": {
            "type": "slide-right",
            "sec": 0.4
