{
  "cst": "1.0",
  "id": "compliance-tip",
  "name": "Compliance Tip",
  "category": "data-leadership",
  "description": "A numbered compliance tip for regulated data (GDPR, HIPAA, CAN-SPAM, TCPA): the rule, a do/don't pair and a CTA.",
  "tags": [
    "compliance",
    "gdpr",
    "hipaa",
    "privacy",
    "tip",
    "series"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "regulation",
      "title",
      "do",
      "dont",
      "cta"
    ],
    "properties": {
      "tip_number": {
        "type": "string",
        "maxLength": 4,
        "x-kind": "text",
        "description": "Tip number in the series, e.g. 12"
      },
      "regulation": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Regulation tag, e.g. GDPR"
      },
      "title": {
        "type": "string",
        "maxLength": 52,
        "x-kind": "text",
        "description": "The tip as a headline"
      },
      "explain": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "text",
        "description": "One or two sentences of context"
      },
      "do": {
        "type": "string",
        "maxLength": 60,
        "x-kind": "text",
        "description": "What to do"
      },
      "dont": {
        "type": "string",
        "maxLength": 60,
        "x-kind": "text",
        "description": "What not to do"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the tip headline"
      },
      "vo_explain": {
        "type": "string",
        "maxLength": 260,
        "x-kind": "voiceover",
        "description": "Voiceover explaining the rule"
      },
      "vo_dodont": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for the do and don't"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "tip_number": "12",
    "regulation": "GDPR",
    "title": "Log consent the moment you collect it",
    "explain": "Regulators ask when, where and how consent was given. A timestamped record answers all three.",
    "do": "Store source, timestamp and wording",
    "dont": "Assume a purchased list is consented",
    "cta": "Get the checklist",
    "music": "calm-tech"
  },
  "scenes": [
