{
  "cst": "1.0",
  "id": "mg-lt-social",
  "name": "Social Handle Lower Third",
  "category": "motion-graphics",
  "description": "White pill with a coloured badge and your handle, labelled with the platform.",
  "tags": [
    "graphic",
    "lower third",
    "social",
    "callout"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "overlay": true,
  "graphic": true,
  "slots": {
    "type": "object",
    "required": [
      "handle"
    ],
    "properties": {
      "handle": {
        "type": "string",
        "maxLength": 32,
        "x-kind": "text",
        "description": "Handle, e.g. @championsgroup"
      },
      "platform": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Platform name"
      },
      "accent": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "x-kind": "color",
        "description": "Accent colour"
      }
    }
  },
  "defaults": {
    "handle": "@championsgroup",
    "platform": "Follow on LinkedIn"
  },
  "background": "#00000000",
  "scenes": [
    {
      "id": "main",
      "role": "overlay",
      "duration": {
        "mode": "fixed",
        "sec": 5
      },
      "layers": [
        {
          "id": "pill",
          "type": "shape",
          "name": "Pill",
          "shape": {
            "kind": "rect",
            "radius": 0.5,
            "fill": "#FFFFFF"
          },
          "box": {
            "*": [
              0.115,
              0.79,
              0.5,
              0.067
            ],
            "vertical": [
              0.16,
              0.7,
              0.7,
              0.04
            ]
          },
          "pin": {
            "to": "handle",
            "pad": [
              0.052,
              0.012,
              0.02,
              0.012
            ]
          },
          "anim_in": {
            "type": "pop",
            "sec": 0.35
          },
          "anim_out": {
            "type": "fade",
            "sec": 0.3
          }
        },
        {
          "id": "badge",
          "type": "shape",
          "name": "Badge",
          "shape": {
            "kind": "ellipse",
            "fill": {
              "$slot": "accent"
            }
          },
          "box": {
            "*": [
              0.071,
              0.794,
              0.032,
              0.0569
