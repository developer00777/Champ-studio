{
  "cst": "1.0",
  "id": "hook-benefits-cta",
  "name": "Hook · Benefits · CTA",
  "category": "social-ads",
  "description": "A bold one-line hook, three numbered benefits and a CTA. The workhorse paid-social format.",
  "tags": [
    "ad",
    "benefits",
    "hook",
    "paid social",
    "linkedin"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "hook",
      "benefits",
      "cta"
    ],
    "properties": {
      "hook": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Scroll-stopping hook, ≤7 words"
      },
      "hook_sub": {
        "type": "string",
        "maxLength": 60,
        "x-kind": "text",
        "description": "Optional line under the hook"
      },
      "benefits_title": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Heading above the benefits"
      },
      "benefits": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 40
        },
        "description": "Exactly three short benefits"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_hook": {
        "type": "string",
        "maxLength": 120,
        "x-kind": "voiceover",
        "description": "Voiceover for the hook"
      },
      "vo_benefits": {
        "type": "string",
        "maxLength": 260,
        "x-kind": "voiceover",
        "description": "Voiceover walking through the three benefits"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "hook": "Your next 100 customers are already searching",
    "hook_sub": "Reach them before your competitors do.",
    "benefits_title": "Why teams switch to us",
    "benefits": [
      "Intent signals updated daily",
      "Direct dials that connect",
      "CRM sync in one click"
    ],
    "cta_headline": "Start reaching in-market buyers",
    "cta": "Book a demo",
    "music": "corporate-upbeat"
  },
  "scenes": [
    {
      "id": "hook",
      "role": "hook",
      "duration": {
        "mode": "voiceover",
        "min": 2.5,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_hook"
      },
      "layers": [
        {
          "type": "color",
          "color": {
            "$brand": "colors.dark"
          }
        },
        {
          "type": "shape",
          "shape": {
            "kind": "rect",
            "fill": {
              "$brand": "colors.primary"
            }
          },
          "box": {
            "*": [
              0.08,
              0.3,
              0.012,
              0.36
            ],
            "vertical": [
              0.08,
              0.32,
              0.02,
              0.26
            ]
          },
          "anim_in": {
            "type": "slide-down",
            "sec": 0.4
          }
        },
        {
          "type": "text",
          "text": "{{hook}}",
          "style": {
            "$brand": "styles.title",
            "size": 100,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.12,
              0.3,
              0.78,
              0.28
            ],
            "vertical": [
              0.13,
              0.32,
              0.79,
              0.2
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.45
          },
          "start": 0.1
        },
        {
          "type": "text",
          "text": "{{hook_sub}}",
          "if": "hook_sub",
          "style": {
            "$brand": "styles.subtitle",
            "weight": 500,
            "size": 40,
            "align": "left",
            "color": "#FFFFFFCC",
            "valign": "top"
          },
          "box": {
            "*": [
              0.12,
              0.6,
              0.7,
              0.08
            ],
            "vertical": [
              0.13,
              0.53,
              0.79,
              0.06
            ]
          },
          "anim_in": {
            "type": "fade",
