{
  "cst": "1.0",
  "id": "save-the-date",
  "name": "Save the Date",
  "category": "events",
  "description": "An elegant, music-only save-the-date: the date as hero, the event over a visual, and an add-to-calendar card.",
  "tags": [
    "save the date",
    "event",
    "announcement",
    "invite"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "date",
      "event",
      "cta"
    ],
    "properties": {
      "date": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "The date, e.g. 14.11.26 or Nov 14"
      },
      "event": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Event name"
      },
      "place": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Venue and city"
      },
      "bg": {
        "x-kind": "media",
        "description": "Elegant visual of the venue or theme"
      },
      "note": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Small note, e.g. Invitation to follow"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "date": "14 Nov 2026",
    "event": "Champions Annual Partner Evening",
    "place": "The Shard, London",
    "note": "Formal invitation to follow",
    "cta": "Add to calendar",
    "music": "inspiring"
  },
