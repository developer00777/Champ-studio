        "description": "Customer 5 name shown under the logo"
      },
      "logo_6": {
        "x-kind": "logo",
        "description": "Customer logo 6 (tile hides the logo when empty)"
      },
      "name_6": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Customer 6 name shown under the logo"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_wall": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover over the logo wall"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
