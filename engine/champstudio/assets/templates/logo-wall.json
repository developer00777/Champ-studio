{
  "cst": "1.0",
  "id": "logo-wall",
  "name": "Logo Wall",
  "category": "social-proof",
  "description": "Up to six customer logos pop into a clean grid under a trust headline, then a CTA. Empty tiles stay tidy.",
  "tags": [
    "logos",
    "customers",
    "trust",
    "clients",
    "social proof"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "headline",
      "cta"
    ],
    "properties": {
      "headline": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Trust headline, e.g. Trusted by 2,000+ revenue teams"
      },
      "logo_1": {
        "x-kind": "logo",
        "description": "Customer logo 1 (tile hides the logo when empty)"
      },
      "name_1": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Customer 1 name shown under the logo"
      },
      "logo_2": {
        "x-kind": "logo",
        "description": "Customer logo 2 (tile hides the logo when empty)"
      },
      "name_2": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Customer 2 name shown under the logo"
      },
      "logo_3": {
        "x-kind": "logo",
        "description": "Customer logo 3 (tile hides the logo when empty)"
      },
      "name_3": {
        "type": "string",
        "maxLength": 20,
        "x-kind": "text",
        "description": "Customer 3 name shown under the logo"
      },
      "logo_4": {
        "x-kind": "logo",
        "description": "Customer logo 4 (tile hides the logo when empty)"
      },
      "name_4": {
        "type": "string",
        "maxLength": 20,
