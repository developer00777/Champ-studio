{
  "cst": "1.0",
  "id": "before-after",
  "name": "Before / After",
  "category": "product-promo",
  "description": "Contrast life before and after your product: two full-bleed scenes with labels, a side-by-side metric comparison and a CTA.",
  "tags": [
    "before after",
    "comparison",
    "transformation",
    "results"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "before",
      "after",
      "before_value",
      "after_value",
      "metric_label",
      "cta"
    ],
    "properties": {
      "before": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "The painful 'before' state"
      },
      "after": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "The improved 'after' state"
      },
      "before_img": {
        "x-kind": "media",
        "description": "Visual of the before state"
      },
      "after_img": {
        "x-kind": "media",
        "description": "Visual of the after state"
      },
      "metric_label": {
        "type": "string",
        "maxLength": 36,
        "x-kind": "text",
        "description": "What is being compared, e.g. Hours spent on list building"
      },
      "before_value": {
        "type": "string",
        "maxLength": 10,
        "x-kind": "text",
        "description": "Before value, e.g. 12 hrs"
      },
      "after_value": {
        "type": "string",
        "maxLength": 10,
        "x-kind": "text",
        "description": "After value, e.g. 45 min"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_before": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the before state"
      },
      "vo_after": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the after state"
      },
      "vo_compare": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover for the comparison"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 100,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "before": "Spreadsheets, guesswork, bounced emails",
    "after": "One verified list, ready to launch",
    "metric_label": "Weekly hours spent building lists",
    "before_value": "12 hrs",
    "after_value": "45 min",
    "cta_headline": "Get your hours back",
    "cta": "See how",
    "music": "corporate-upbeat"
  },
  "scenes": [
    {
      "id": "before",
      "role": "before",
      "duration": {
        "mode": "voiceover",
        "min": 3,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_before"
      },
      "layers": [
        {
          "type": "media",
          "src": {
            "$slot": "before_img"
          },
          "motion": "kenburns-out"
        },
        {
          "type": "shape",
          "name": "Scrim",
          "shape": {
            "kind": "rect",
            "gradient": [
              "#00000088",
              "#000000EE"
            ]
          }
        },
        {
          "type": "text",
          "text": "BEFORE",
          "style": {
            "$brand": "styles.subtitle",
            "size": 34,
            "weight": 800,
            "uppercase": true,
            "align": "left",
            "bg_color": {
              "$brand": "colors.dark"
            },
            "bg_padding": 0.5,
            "bg_radius": 0.3
          },
          "box": {
            "*": [
              0.08,
              0.3,
              0.3,
              0.08
            ],
            "vertical": [
              0.08,
              0.31,
              0.6,
              0.07
            ]
          },
          "anim_in": {
            "type": "fade",
            "sec": 0.3
          }
        },
        {
          "type": "text",
          "text": "{{before}}",
          "style": {
            "$brand": "styles.title",
            "size": 92,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.41,
              0.8,
              0.3
            ],
            "vertical": [
              0.08,
              0.4,
              0.84,
              0.22
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.45
          },
          "start": 0.15
