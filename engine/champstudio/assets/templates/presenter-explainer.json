    {
      "id": "cta",
      "role": "cta",
      "duration": {
        "mode": "voiceover",
        "min": 3.0,
        "pad": 0.6
      },
      "vo": {
        "$slot": "vo_cta"
      },
      "transition": {
        "type": "crossfade",
        "sec": 0.4
      },
      "layers": [
        {
          "type": "shape",
          "shape": {
            "kind": "rect",
            "gradient": {
              "$brand": "gradients.hero"
            }
          }
        },
        {
          "type": "logo",
          "box": {
            "*": [
              0.3,
              0.13,
              0.4,
              0.12
            ],
            "vertical": [
              0.12,
              0.18,
              0.76,
              0.06
            ]
          },
          "anim_in": {
            "type": "fade",
            "sec": 0.4
          }
        },
        {
          "type": "text",
          "text": "{{cta_headline}}",
          "style": {
            "$brand": "styles.title",
            "size": 80
