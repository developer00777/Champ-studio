            ],
            "1:1": [
              0.03,
              0.78,
              0.44,
              0.075
            ]
          },
          "anim_in": {
            "type": "slide-right",
            "sec": 0.4
          },
          "start": 0.4,
          "end": 6.0,
          "anim_out": {
            "type": "fade",
            "sec": 0.3
          }
        },
        {
          "type": "text",
          "text": "{{presenter_role}}",
          "if": "presenter_role",
          "style": {
            "$brand": "styles.subtitle",
            "size": 30,
            "align": "left",
