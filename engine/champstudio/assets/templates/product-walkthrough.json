{
  "cst": "1.0",
  "id": "product-walkthrough",
  "name": "Product Walkthrough",
  "category": "product-promo",
  "description": "Title card, three screenshot steps with slow pans and numbered captions, then a CTA. Ideal for onboarding and demos.",
  "tags": [
    "walkthrough",
    "demo",
    "screenshots",
    "saas",
    "onboarding"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "title",
      "step_1",
      "step_2",
      "step_3",
      "screen_1",
      "screen_2",
      "screen_3",
      "cta"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Walkthrough title"
      },
      "subtitle": {
        "type": "string",
        "maxLength": 60,
        "x-kind": "text",
        "description": "Optional line under the title"
      },
      "screen_1": {
        "x-kind": "media",
        "description": "Screenshot for step 1",
        "x-media": [
          "image"
        ]
      },
      "step_1": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Step 1 title"
      },
      "step_1_body": {
        "type": "string",
        "maxLength": 80,
        "x-kind": "text",
        "description": "Step 1 one-line explanation"
      },
      "vo_step_1": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for step 1"
      },
      "screen_2": {
        "x-kind": "media",
        "description": "Screenshot for step 2",
        "x-media": [
          "image"
        ]
      },
      "step_2": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Step 2 title"
      },
      "step_2_body": {
        "type": "string",
        "maxLength": 80,
        "x-kind": "text",
        "description": "Step 2 one-line explanation"
      },
      "vo_step_2": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for step 2"
      },
      "screen_3": {
        "x-kind": "media",
        "description": "Screenshot for step 3",
        "x-media": [
          "image"
        ]
      },
      "step_3": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Step 3 title"
      },
      "step_3_body": {
        "type": "string",
        "maxLength": 80,
        "x-kind": "text",
        "description": "Step 3 one-line explanation"
      },
      "vo_step_3": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for step 3"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover introducing the walkthrough"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "title": "Build a target list in 3 steps",
    "subtitle": "From blank page to export-ready in under five minutes.",
    "step_1": "Choose your ideal customer",
    "step_1_body": "Filter by industry, size, tech stack and region.",
    "step_2": "Add buying-group contacts",
    "step_2_body": "Pull verified emails and direct dials for every role.",
    "step_3": "Push to your CRM",
    "step_3_body": "One click sends the list to Salesforce or HubSpot.",
    "cta_headline": "Try it on your own market",
    "cta": "Start free",
    "music": "calm-tech"
  },
