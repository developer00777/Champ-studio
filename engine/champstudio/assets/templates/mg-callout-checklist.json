{
  "cst": "1.0",
  "id": "mg-callout-checklist",
  "name": "Checklist",
  "category": "motion-graphics",
  "description": "Three points that tick in one by one with accent markers.",
  "tags": [
    "graphic",
    "callout",
    "list",
    "explainer"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "overlay": true,
  "graphic": true,
  "slots": {
    "type": "object",
    "required": [
      "item_1"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Title"
      },
      "item_1": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Point 1"
      },
      "item_2": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Point 2"
      },
      "item_3": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Point 3"
      },
      "accent": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "x-kind": "color",
        "description": "Accent colour"
      }
    }
  },
  "defaults": {
    "title": "Why teams switch",
    "item_1": "Forecasts update in real time",
    "item_2": "Every deal has a next step",
    "item_3": "No more spreadsheet roll-ups"
  },
  "background": "#00000000",
  "scenes": [
    {
      "id": "main",
      "role": "overlay",
      "duration": {
        "mode": "fixed",
        "sec": 6
      },
      "layers": [
        {
          "id": "title",
          "type": "text",
          "name": "Title",
          "text": "{{title}}",
          "if": "title",
          "box": {
            "*": [
              0.1,
              0.24,
              0.8,
              0.1
            ],
            "vertical": [
              0.08,
              0.3,
              0.84,
              0.06
            ]
          },
          "style": {
            "$brand": "styles.title",
            "shadow": true,
            "bg_color": "",
            "size": 72,
            "color": "#FFFFFF",
            "align": "left"
          },
          "text_anim": {
            "by": "word",
            "type": "rise",
            "duration": 0.3,
            "stagger": 0.06,
            "delay": 0.0,
            "order": "forward",
            "out": false
          },
          "anim_out": {
            "type": "fade",
            "sec": 0.3
          }
        },
        {
          "id": "mark0",
          "type": "shape",
          "name": "Marker 1",
          "shape": {
            "kind": "ellipse",
            "fill": {
              "$slot": "accent"
            }
          },
          "bind": {
            "enabled": "{{item_1}}"
          },
          "start": 0.5,
          "box": {
            "*": [
              0.1,
              0.405,
              0.026,
              0.0462
            ],
            "vertical": [
              0.08,
              0.405,
              0.05,
              0.028
            ]
          },
          "anim_in": {
            "type": "pop",
            "sec": 0.35
          },
          "anim_out": {
            "type": "fade",
            "sec": 0.3
          }
        },
        {
          "id": "item0",
          "type": "text",
          "name": "Point 1",
          "text": "{{item_1}}",
          "start": 0.55,
          "box": {
            "*": [
              0.145,
              0.395,
              0.75,
              0.066
            ],
            "vertical": [
              0.15,
              0.398,
              0.78,
              0.042
            ]
          },
          "style": {
            "$brand": "styles.subtitle",
            "shadow": true,
