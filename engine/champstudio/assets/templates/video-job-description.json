{
  "cst": "1.0",
  "id": "video-job-description",
  "name": "Video Job Description",
  "category": "recruitment",
  "description": "A full job description as video: role overview, what you'll do, what you'll bring, the perks and how to apply.",
  "tags": [
    "job description",
    "jd",
    "hiring",
    "recruitment",
    "careers"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "role",
      "do",
      "bring",
      "perks",
      "cta"
    ],
    "properties": {
      "role": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Job title"
      },
      "team": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Team, location and type, e.g. Data Team · Remote · Full-time"
      },
      "bg": {
        "x-kind": "media",
        "description": "Visual of the team or workplace"
      },
      "mission": {
        "type": "string",
        "maxLength": 90,
        "x-kind": "text",
        "description": "One-line mission of the role"
      },
      "do": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "What you'll do"
      },
      "bring": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "What you'll bring"
      },
      "perks": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 36
        },
        "description": "Three perks"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "apply_note": {
        "type": "string",
        "maxLength": 56,
        "x-kind": "text",
        "description": "How to apply, e.g. Apply at careers.example.com"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 220,
        "x-kind": "voiceover",
        "description": "Voiceover for the overview"
      },
      "vo_do": {
        "type": "string",
        "maxLength": 320,
        "x-kind": "voiceover",
        "description": "Voiceover for what you'll do"
      },
      "vo_bring": {
        "type": "string",
        "maxLength": 320,
        "x-kind": "voiceover",
        "description": "Voiceover for what you'll bring"
      },
      "vo_perks": {
        "type": "string",
        "maxLength": 240,
        "x-kind": "voiceover",
        "description": "Voiceover for the perks"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for how to apply"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "role": "Account Executive, Healthcare Data",
    "team": "Sales · London · Full-time",
    "mission": "Help hospitals and life-science teams reach the right decision makers.",
    "do": [
      "Own a pipeline of mid-market accounts",
      "Run discovery and tailored demos",
      "Close new and expansion deals",
      "Partner with marketing on campaigns"
    ],
    "bring": [
      "3+ years closing B2B SaaS or data",
      "Curiosity about healthcare markets",
      "A habit of hitting quota"
    ],
    "perks": [
      "Uncapped commission",
      "Hybrid, flexible hours",
      "Annual learning budget"
    ],
    "cta": "Apply now",
    "apply_note": "Applications reviewed weekly",
    "music": "corporate-upbeat"
  },
  "scenes": [
    {
      "id": "intro",
      "role": "hook",
      "duration": {
        "mode": "voiceover",
        "min": 4,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_intro"
      },
      "layers": [
        {
          "type": "media",
          "src": {
            "$slot": "bg"
          },
          "motion": "kenburns-in"
        },
        {
          "type": "shape",
          "name": "Scrim",
          "shape": {
            "kind": "rect",
            "gradient": [
              "#00000033",
              "#000000CC"
            ]
          }
        },
        {
          "type": "text",
          "text": "{{team}}",
          "style": {
            "$brand": "styles.lower_third",
            "size": 28,
            "uppercase": true
          },
          "box": {
            "*": [
              0.08,
              0.27,
              0.6,
              0.065
            ],
            "vertical": [
              0.08,
              0.3,
              0.84,
              0.056
            ]
          },
          "anim_in": {
            "type": "slide-right",
            "sec": 0.4
          }
        },
        {
          "type": "text",
          "text": "{{role}}",
          "style": {
            "$brand": "styles.title",
            "size": 92,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.36,
              0.8,
              0.3
            ],
            "vertical": [
              0.08,
              0.36,
              0.84,
              0.24
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.5
          },
          "start": 0.15
        },
        {
          "type": "text",
          "text": "{{mission}}",
          "if": "mission",
          "style": {
            "$brand": "styles.subtitle",
            "weight": 500,
            "size": 38,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.67,
              0.66,
              0.12
            ],
            "vertical": [
              0.08,
              0.61,
              0.84,
              0.1
            ]
          },
          "anim_in": {
            "type": "fade",
            "sec": 0.4
          },
          "start": 0.45
        }
      ]
    },
    {
      "id": "do",
      "role": "list",
      "duration": {
        "mode": "voiceover",
