# Copy to .env next to docker-compose.yml (or export in your shell).
# Keys can also be entered in the web UI Settings instead — both work.

# OpenRouter — one key for images AND videos (openrouter.ai/keys)
OPENROUTER_API_KEY=

# MuAPI — optional secondary generation provider (muapi.ai)
MUAPI_API_KEY=

# Optional: require this Bearer token on all API calls (shared/team deployments)
# CHAMP_STUDIO_ACCESS_TOKEN=change-me
