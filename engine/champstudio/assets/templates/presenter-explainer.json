{
  "cst": "1.0",
  "id": "presenter-explainer",
  "name": "Presenter Explainer",
  "category": "explainers",
  "description": "A presenter or AI avatar on one side, the key points building up beside them, with a name lower third, intro card and CTA.",
  "tags": [
    "presenter",
    "talking head",
    "avatar",
    "explainer",
    "training"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "title",
      "presenter",
      "presenter_name",
      "points",
      "cta",
      "vo_talk"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Topic title"
      },
      "presenter": {
        "x-kind": "media",
        "description": "Presenter video (uploaded or AI avatar), framed mid-shot"
      },
      "presenter_name": {
        "type": "string",
        "maxLength": 32,
        "x-kind": "text",
        "description": "Presenter name"
      },
      "presenter_role": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Presenter title"
      },
      "points_title": {
        "type": "string",
        "maxLength": 32,
        "x-kind": "text",
        "description": "Heading above the points"
      },
      "points": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 36
        },
        "description": "Three key points, revealed as the presenter speaks"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the title card"
      },
      "vo_talk": {
        "type": "string",
        "maxLength": 700,
        "x-kind": "voiceover",
        "description": "The presenter's script"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "title": "Three ways to clean your CRM",
    "presenter_name": "Priya Raman",
    "presenter_role": "Head of Data Quality",
    "points_title": "In this video",
    "points": [
      "Merge duplicate accounts",
      "Re-verify stale contacts",
      "Enrich missing fields"
    ],
    "cta_headline": "Get a free CRM health check",
    "cta": "Book my audit",
    "music": "calm-tech"
  },
  "scenes": [
    {
      "id": "intro",
      "role": "intro",
      "duration": {
        "mode": "voiceover",
        "min": 2.5,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_intro"
      },
      "layers": [
        {
          "type": "color",
          "color": {
            "$brand": "colors.background"
          }
        },
        {
          "type": "shape",
          "name": "Rule",
          "shape": {
            "kind": "rect",
            "fill": {
              "$brand": "colors.primary"
            }
          },
          "box": {
            "*": [
              0.08,
              0.26,
              0.06,
              0.008
            ],
            "vertical": [
              0.08,
              0.3,
              0.12,
              0.005
            ]
          },
          "anim_in": {
            "type": "wipe",
            "sec": 0.4
          }
        },
        {
          "type": "text",
          "text": "{{presenter_name}}",
          "style": {
            "$brand": "styles.subtitle",
            "size": 28,
            "weight": 800,
            "uppercase": true,
            "color": {
              "$brand": "colors.primary"
            },
            "align": "left"
          },
          "box": {
            "*": [
              0.08,
              0.28500000000000003,
              0.7,
              0.06
            ],
            "vertical": [
              0.08,
              0.312,
              0.84,
              0.035
            ]
          },
          "anim_in": {
            "type": "fade",
            "sec": 0.35
          },
          "start": 0.1
        },
        {
          "type": "text",
          "text": "{{title}}",
          "style": {
            "$brand": "styles.title",
            "color": {
              "$brand": "colors.text"
            },
            "shadow": false,
            "size": 100,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.36,
              0.8,
              0.28
            ],
            "vertical": [
              0.08,
              0.36,
              0.84,
              0.2
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.45
          },
          "start": 0.2
        }
      ]
    },
    {
      "id": "talk",
      "role": "presenter",
      "duration": {
        "mode": "voiceover",
        "min": 10,
        "pad": 0.5
      },
      "vo": {
        "$slot": "vo_talk"
      },
      "transition": {
        "type": "slide-left",
        "sec": 0.4
      },
      "layers": [
        {
          "type": "color",
          "color": {
            "$brand": "colors.background"
          }
        },
        {
          "type": "media",
          "src": {
            "$slot": "presenter"
          },
          "motion": "none",
          "box": {
            "*": [
              0.0,
              0.0,
              0.5,
              1.0
            ],
            "vertical": [
              0.0,
              0.0,
              1.0,
              0.5
            ],
            "1:1": [
              0.0,
              0.0,
              0.5,
              1.0
            ]
          },
          "with_audio": true
        },
        {
          "type": "text",
