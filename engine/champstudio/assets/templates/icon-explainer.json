{
  "cst": "1.0",
  "id": "icon-explainer",
  "name": "Icon Explainer",
  "category": "explainers",
  "description": "Three concepts as icon cards (symbol in a brand-coloured badge, label, one-liner), a summary line and a CTA.",
  "tags": [
    "explainer",
    "icons",
    "concepts",
    "features",
    "infographic"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "title",
      "label_1",
      "label_2",
      "label_3",
      "cta"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Topic title"
      },
      "icon_1": {
        "type": "string",
        "maxLength": 2,
        "x-kind": "text",
        "description": "Concept 1 symbol, one character such as ✓ → ★ ● ▲ or a digit"
      },
      "label_1": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Concept 1 label, one or two words"
      },
      "desc_1": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Concept 1 short description"
      },
      "icon_2": {
        "type": "string",
        "maxLength": 2,
        "x-kind": "text",
        "description": "Concept 2 symbol, one character such as ✓ → ★ ● ▲ or a digit"
      },
      "label_2": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Concept 2 label, one or two words"
      },
      "desc_2": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Concept 2 short description"
      },
      "icon_3": {
        "type": "string",
        "maxLength": 2,
        "x-kind": "text",
        "description": "Concept 3 symbol, one character such as ✓ → ★ ● ▲ or a digit"
      },
      "label_3": {
        "type": "string",
        "maxLength": 18,
        "x-kind": "text",
        "description": "Concept 3 label, one or two words"
      },
      "desc_3": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Concept 3 short description"
      },
      "summary": {
        "type": "string",
        "maxLength": 64,
        "x-kind": "text",
        "description": "One-line summary that ties the concepts together"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover introducing the topic"
      },
      "vo_concepts": {
        "type": "string",
        "maxLength": 320,
        "x-kind": "voiceover",
        "description": "Voiceover explaining the three concepts"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover for the summary and CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
