{
  "cst": "1.0",
  "id": "webinar-promo",
  "name": "Webinar Promo",
  "category": "events",
  "description": "Promote a live webinar: title over a visual, date card with speakers, what attendees will learn, and a save-your-seat CTA.",
  "tags": [
    "webinar",
    "event",
    "live",
    "registration",
    "promo"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "title",
      "day",
      "month",
      "speakers",
      "learn",
      "cta"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 56,
        "x-kind": "text",
        "description": "Webinar title"
      },
      "subtitle": {
        "type": "string",
        "maxLength": 70,
        "x-kind": "text",
        "description": "One line on who it is for"
      },
      "bg": {
        "x-kind": "media",
        "description": "Background visual for the title card"
      },
      "day": {
        "type": "string",
        "maxLength": 3,
        "x-kind": "text",
        "description": "Day of month, e.g. 12"
      },
      "month": {
        "type": "string",
        "maxLength": 10,
        "x-kind": "text",
        "description": "Month, e.g. NOV"
      },
      "time": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Time and zone, e.g. 11:00 ET"
      },
      "speakers": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Speakers as 'Name, Title'"
      },
      "learn": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 44
        },
        "description": "Three things attendees will learn"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_intro": {
        "type": "string",
        "maxLength": 160,
        "x-kind": "voiceover",
        "description": "Voiceover announcing the webinar"
      },
      "vo_details": {
        "type": "string",
        "maxLength": 200,
        "x-kind": "voiceover",
        "description": "Voiceover for date and speakers"
      },
      "vo_learn": {
        "type": "string",
        "maxLength": 260,
        "x-kind": "voiceover",
        "description": "Voiceover for what they will learn"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "title": "Building a pipeline engine with intent data",
    "subtitle": "A 45-minute masterclass for B2B revenue leaders",
    "day": "12",
    "month": "Nov",
    "time": "11:00 ET · 45 min",
    "speakers": [
      "Maya Chen, VP Growth, Northwind",
      "Arjun Mehta, Head of Data, Champions Group"
    ],
    "learn": [
      "Which intent signals actually predict deals",
      "How to route surges to reps in hours",
      "The metrics boards now ask for"
    ],
    "cta_headline": "Seats are limited",
    "cta": "Save my seat",
    "music": "corporate-upbeat"
  },
  "scenes": [
    {
      "id": "intro",
      "role": "hook",
      "duration": {
        "mode": "voiceover",
        "min": 3,
        "pad": 0.4
      },
      "vo": {
        "$slot": "vo_intro"
      },
      "layers": [
        {
          "type": "media",
          "src": {
            "$slot": "bg"
          },
          "motion": "kenburns-in"
        },
        {
          "type": "shape",
          "name": "Scrim",
          "shape": {
            "kind": "rect",
            "gradient": [
              "#00000033",
              "#000000CC"
            ]
          }
        },
        {
          "type": "text",
          "text": "Live webinar",
          "style": {
            "$brand": "styles.lower_third",
            "size": 28,
            "uppercase": true
          },
          "box": {
            "*": [
              0.08,
              0.27,
              0.6,
              0.065
            ],
            "vertical": [
              0.08,
              0.3,
              0.84,
              0.056
            ]
          },
          "anim_in": {
            "type": "slide-right",
            "sec": 0.4
          }
        },
        {
          "type": "text",
          "text": "{{title}}",
          "style": {
            "$brand": "styles.title",
            "size": 88,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.36,
              0.8,
              0.3
            ],
            "vertical": [
              0.08,
              0.36,
              0.84,
              0.24
            ]
          },
          "anim_in": {
            "type": "slide-up",
            "sec": 0.5
          },
          "start": 0.15
        },
        {
          "type": "text",
          "text": "{{subtitle}}",
          "if": "subtitle",
          "style": {
            "$brand": "styles.subtitle",
            "weight": 500,
            "size": 38,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
              0.08,
              0.67,
              0.66,
              0.12
            ],
            "vertical": [
              0.08,
              0.61,
              0.84,
              0.1
