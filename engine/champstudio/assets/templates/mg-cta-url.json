{
  "cst": "1.0",
  "id": "mg-cta-url",
  "name": "Browser URL Bar",
  "category": "motion-graphics",
  "description": "A browser address bar where your URL types itself in, with a blinking cursor.",
  "tags": [
    "graphic",
    "cta",
    "website",
    "url"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "overlay": true,
  "graphic": true,
  "slots": {
    "type": "object",
    "required": [
      "url"
    ],
    "properties": {
      "url": {
        "type": "string",
        "maxLength": 40,
        "x-kind": "text",
        "description": "Web address"
      },
      "accent": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "x-kind": "color",
        "description": "Accent colour"
      }
    }
  },
  "defaults": {
    "url": "championsgroup.com/report"
  },
  "background": "#00000000",
  "scenes": [
