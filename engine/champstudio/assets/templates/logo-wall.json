        "description": "Customer 4 name shown under the logo"
      },
      "logo_5": {
        "x-kind": "logo",
        "description": "Customer logo 5 (tile hides the logo when empty)"
      },
      "name_5": {
        "type": "string",
        "maxLength": 20,
