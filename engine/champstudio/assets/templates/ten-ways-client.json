          },
          "start": 0.15
        },
        {
          "type": "text",
          "text": "{{subtitle}}",
          "if": "subtitle",
          "style": {
            "$brand": "styles.subtitle",
            "weight": 500,
            "size": 38,
            "align": "left",
            "valign": "top"
          },
          "box": {
            "*": [
