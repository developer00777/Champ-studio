{
  "cst": "1.0",
  "id": "lead-magnet-promo",
  "name": "Lead Magnet Promo",
  "category": "sales-enablement",
  "description": "Promote a gated guide or ebook: hook, a branded cover mock-up with what's inside, and a download CTA.",
  "tags": [
    "lead magnet",
    "ebook",
    "guide",
    "gated content",
    "download"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "slots": {
    "type": "object",
    "required": [
      "hook",
      "guide_title",
      "inside",
      "cta"
    ],
    "properties": {
      "hook": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Hook question or promise"
      },
      "guide_type": {
        "type": "string",
        "maxLength": 16,
        "x-kind": "text",
        "description": "Format, e.g. FREE GUIDE"
      },
      "guide_title": {
        "type": "string",
        "maxLength": 48,
        "x-kind": "text",
        "description": "Guide title, shown on the cover"
      },
      "inside": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "x-kind": "list",
        "items": {
          "type": "string",
          "maxLength": 40
        },
        "description": "Three things inside"
      },
      "cta_headline": {
        "type": "string",
        "maxLength": 44,
        "x-kind": "text",
        "description": "Closing line above the button"
      },
      "cta": {
        "type": "string",
        "maxLength": 24,
        "x-kind": "text",
        "description": "Call to action"
      },
      "vo_hook": {
        "type": "string",
        "maxLength": 140,
        "x-kind": "voiceover",
        "description": "Voiceover for the hook"
      },
      "vo_guide": {
        "type": "string",
        "maxLength": 320,
        "x-kind": "voiceover",
        "description": "Voiceover for the guide and what's inside"
      },
      "vo_cta": {
        "type": "string",
        "maxLength": 110,
        "x-kind": "voiceover",
        "description": "Voiceover for the CTA"
      },
      "music": {
        "type": "string",
        "x-kind": "music",
        "description": "Music mood"
      }
    }
  },
  "defaults": {
    "hook": "Is your CRM quietly decaying?",
    "guide_type": "Free guide",
    "guide_title": "The B2B Data Hygiene Playbook",
    "inside": [
      "A 15-minute CRM health audit",
      "Decay benchmarks by industry",
      "A 90-day clean-up plan"
    ],
    "cta_headline": "Get the playbook free",
    "cta": "Download now",
    "music": "calm-tech"
  },
